{
	"name": "gregory.sh",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "echo 'ERROR: Use dev:port <port> for multi-worktree support' && exit 1",
		"dev:port": "vite dev --port",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"test:health-state": "vitest run --config vitest.health-state.config.ts",
		"check:health-vendor": "node vendor/health-contract/scripts/verify-health-vendor.mjs vendor/health-contract --manifest-sha256 f3bbeb66af0da02225ad26322252b55aa260e0d8af7d95e9424c11e1bfb8033d",
		"og:generate": "bun run scripts/generate-og-images.ts",
		"publish": "bun run scripts/publish.ts",
		"newsroom:pull": "bun run scripts/newsroom-pull.ts",
		"newsroom:generate": "bunx openapi-typescript src/lib/newsroom/openapi.json -o src/lib/newsroom/types.ts",
		"newsroom:check": "bun run scripts/newsroom-check.ts"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^4.20260207.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-cloudflare": "^7.2.6",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@the-software-engineer/unikraft-deploy-health": "file:vendor/health-contract",
		"@types/node": "^25.2.2",
		"@vitest/runner": "4.1.11",
		"@vitest/snapshot": "4.1.11",
		"gray-matter": "^4.0.3",
		"jsdom": "^28.0.0",
		"mdsvex": "^0.12.6",
		"openapi-typescript": "~7.13.0",
		"satori": "^0.19.1",
		"svelte": "^5.50.0",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.7",
		"wrangler": "^4.94.0"
	},
	"dependencies": {
		"openapi-fetch": "^0.17.0"
	}
}
