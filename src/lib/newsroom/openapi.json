{
  "openapi": "3.1.0",
  "info": {
    "title": "Newsroom API",
    "description": "TypeScript port of the newsroom server (TSE-703), proven route by route against the now-retired tests/parity contract; the full target shape is docs/specs/newsroom-api.yaml.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness, the database, and the active run, if any.",
        "tags": [
          "server"
        ],
        "responses": {
          "200": {
            "description": "Server is up. 200 whatever db says: this is the liveness route the deploy waits on.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "version": {
                      "type": "string"
                    },
                    "active_run": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "db": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok",
                    "version",
                    "active_run",
                    "db"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/lists/{list}/members/{email}": {
      "get": {
        "operationId": "readListMember",
        "security": [
          {
            "listToken": []
          }
        ],
        "summary": "Whether one address is on a list",
        "tags": [
          "lists"
        ],
        "description": "REQ-LST-MEMBER-STATE, REQ-LST-MEMBER-UNKNOWN. `unknown` is an address this list has never held. An address that left is `unsubscribed` and keeps the two times of its latest episode.",
        "responses": {
          "200": {
            "description": "What the list holds for the address",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "subscribed",
                        "unsubscribed",
                        "unknown"
                      ]
                    },
                    "joined_at": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "left_at": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No usable bearer token was presented",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "The token presented may not touch this list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No such resource",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "list",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "email",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ]
      }
    },
    "/v1/lists/{list}/subscribe": {
      "post": {
        "operationId": "subscribeToList",
        "security": [
          {
            "listToken": []
          }
        ],
        "summary": "Put an address on a list",
        "tags": [
          "lists"
        ],
        "description": "REQ-LST-SUB-NEW, REQ-LST-SUB-ALREADY. Idempotent: an address already on the list answers `already` and nothing changes but the time it was last seen. `fields` carries the extras this list asks for at signup and is written on the episode this call opens.",
        "responses": {
          "200": {
            "description": "The address is on the list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "subscribed",
                        "already"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No usable bearer token was presented",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "The token presented may not touch this list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No such resource",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "list",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/lists/{list}/unsubscribe": {
      "post": {
        "operationId": "unsubscribeFromList",
        "security": [
          {
            "listToken": []
          }
        ],
        "summary": "Take an address off a list",
        "tags": [
          "lists"
        ],
        "description": "REQ-LST-UNSUB-EMAIL, REQ-LST-UNSUB-TOKEN. Exactly one of `email` and `token`. A token is the one the newsroom signed into that message's unsubscribe URL, and it is verified against this list. The answer says whether an open signup was closed and nothing else.",
        "responses": {
          "200": {
            "description": "The address is off the list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "removed",
                        "unknown"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Request failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No usable bearer token was presented",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "The token presented may not touch this list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No such resource",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "detail"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "list",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "token": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "listToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "The bearer token for one consumer site, which may touch exactly the lists content/lists.yml scopes to its variable."
      }
    }
  }
}
