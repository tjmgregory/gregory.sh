{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "gregory-sh-short-link-card-proof",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "gregory.sh/z/test*",
			"zone_name": "gregory.sh"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
