{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/the-software-engineer/unikraft-deploy/main/health/schema-v1.json",
  "title": "TSE service health v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "version", "serviceId", "checks"],
  "properties": {
    "status": { "$ref": "#/$defs/status" },
    "version": { "type": "string", "pattern": "^.+$" },
    "serviceId": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/check" }
      }
    }
  },
  "$defs": {
    "status": { "enum": ["pass", "warn", "fail"] },
    "baseCheck": {
      "type": "object",
      "required": ["componentType", "status"],
      "properties": {
        "componentType": { "enum": ["datastore", "system", "dependency"] },
        "componentId": { "type": "string", "pattern": "^.+$" },
        "status": { "$ref": "#/$defs/status" },
        "time": { "$ref": "#/$defs/timestamp" },
        "output": { "type": "string" }
      }
    },
    "localCheck": {
      "allOf": [
        { "$ref": "#/$defs/baseCheck" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "componentType": { "enum": ["datastore", "system"] },
            "componentId": { "type": "string", "pattern": "^.+$" },
            "status": { "$ref": "#/$defs/status" },
            "time": { "$ref": "#/$defs/timestamp" },
            "output": { "type": "string" }
          }
        }
      ]
    },
    "dependencyCheck": {
      "allOf": [
        { "$ref": "#/$defs/baseCheck" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "componentId",
            "time",
            "cadenceSeconds",
            "lastAttemptAt",
            "lastSuccessAt",
            "lastError",
            "observedValue",
            "observedUnit"
          ],
          "properties": {
            "componentType": { "const": "dependency" },
            "componentId": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "status": { "$ref": "#/$defs/status" },
            "time": { "$ref": "#/$defs/timestamp" },
            "output": { "type": "string" },
            "cadenceSeconds": { "type": "integer", "minimum": 1 },
            "lastAttemptAt": {
              "anyOf": [
                { "$ref": "#/$defs/timestamp" },
                { "type": "null" }
              ]
            },
            "lastSuccessAt": {
              "anyOf": [
                { "$ref": "#/$defs/timestamp" },
                { "type": "null" }
              ]
            },
            "lastError": {
              "anyOf": [
                { "type": "string", "pattern": "^.+$" },
                { "type": "null" }
              ]
            },
            "observedValue": {
              "anyOf": [
                { "type": "number", "minimum": 0 },
                { "type": "null" }
              ]
            },
            "observedUnit": { "const": "s" }
          }
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "check": {
      "oneOf": [
        { "$ref": "#/$defs/localCheck" },
        { "$ref": "#/$defs/dependencyCheck" }
      ]
    }
  }
}
